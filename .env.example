# WeCom long-connection bot credentials
WECOM_BOT_ID=aibqxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECOM_BOT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECOM_WS_ENDPOINT=wss://openws.work.weixin.qq.com

# Codex model
CODEX_IM_DEFAULT_CODEX_MODEL=gpt-5.3-codex
CODEX_IM_DEFAULT_CODEX_EFFORT=medium
CODEX_IM_DEFAULT_CODEX_ACCESS_MODE=default

# Bot behavior
CODEX_IM_DEFAULT_WORKSPACE_ID=default
# Whether WeCom replies are streamed in real time.
# false = default, send once after run completes
CODEX_IM_WECOM_STREAMING_OUTPUT=false

CODEX_IM_WECOM_MAX_FILE_SIZE_MB=20

# Restrict which local directories can be bound from WeCom
# Comma-separated absolute paths. Leave empty to allow any absolute path.
CODEX_IM_WORKSPACE_ALLOWLIST=

# Optional explicit Codex endpoint. Leave empty to spawn `codex app-server`.
CODEX_IM_CODEX_ENDPOINT=

# Quota status lookup
# Defaults to ~/.codex/auth.json and https://chatgpt.com/backend-api/wham/usage
CODEX_IM_QUOTA_AUTH_FILE=
CODEX_IM_QUOTA_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
CODEX_IM_QUOTA_TIMEOUT_SECONDS=30
CODEX_IM_QUOTA_ACCESS_TOKEN=
CODEX_IM_QUOTA_ACCOUNT_ID=

# Optional session persistence location
CODEX_IM_SESSIONS_FILE=C:\\Users\\your-name\\.codex-im\\sessions.json
